# Modele de variables d'environnement pour NeneCare.
# Copier ce fichier en ".env" (ignore par git) et adapter les valeurs.
# Charger ensuite avant de lancer l'app, par exemple :
#   set -a && source .env && set +a && ./mvnw spring-boot:run

# ===== Base de donnees PostgreSQL =====
DB_URL=jdbc:postgresql://localhost:5432/nenecare
DB_USERNAME=postgres
DB_PASSWORD=changez-moi

# ===== Secret JWT (au moins 32 caracteres) =====
JWT_SECRET=mon-secret-jwt-local-de-32-caracteres-minimum
