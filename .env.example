# Variables d'environnement NeneCare
# Usage : copier ce fichier en .env, puis renseigner chaque valeur.
# Le fichier .env ne doit JAMAIS être versionné (voir .gitignore).

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/nenecare
DB_USERNAME=nenecare
DB_PASSWORD=

# --- Chiffrement AES-256-GCM ---
# Clé de 32 octets encodée en Base64.
# Générer : openssl rand -base64 32
# ATTENTION : toute valeur incorrecte provoque un refus de démarrage immédiat.
NENECARE_ENCRYPTION_KEY=

# --- JWT (module auth — thesombrecoder18) ---
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
